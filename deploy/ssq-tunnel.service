# 境内 SSH SOCKS 隧道：供 lottery-server 抓取福彩官网数据使用。
# 官网对境外 IP 403，境内服务器出口可正常访问。
# 部署：sudo cp ssq-tunnel.service /etc/systemd/system/ && sudo systemctl enable --now ssq-tunnel
[Unit]
Description=SSH SOCKS tunnel to CN server (lottery data fetch)
After=network-online.target
Wants=network-online.target

[Service]
# 以下为模板：<境外服务器用户>、<境内服务器> 部署时替换为真实值，不要提交真实地址到仓库
# 密钥在境外服务器用户家目录（已添加到境内服务器 authorized_keys）
User=<境外服务器用户>
ExecStart=/usr/bin/ssh -i /home/<境外服务器用户>/.ssh/id_ed25519 \
  -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes -o BatchMode=yes \
  -o StrictHostKeyChecking=accept-new \
  -D 127.0.0.1:11000 -N <境内服务器>
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
